{
    "name": "@shoukhinabesh/server",
    "version": "1.0.0",
    "private": true,
    "description": "NestJS backend API for Shoukhinabesh eCommerce with PostgreSQL TypeORM, JWT RBAC, and Swagger",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "seed": "node check-db.js && ts-node src/database/seeds/seed.ts",
        "test": "jest"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.1",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.4.1",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.1",
        "@nestjs/swagger": "^7.4.0",
        "@nestjs/typeorm": "^10.0.2",
        "axios": "^1.19.0",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cloudinary": "^2.4.0",
        "dotenv": "^16.4.5",
        "helmet": "^7.1.0",
        "multer": "^1.4.5-lts.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.12.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.20"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.4",
        "@nestjs/schematics": "^10.1.3",
        "@nestjs/testing": "^10.4.1",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.21",
        "@types/multer": "^1.4.12",
        "@types/node": "^20.14.12",
        "@types/passport-jwt": "^4.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.4"
    }
}
